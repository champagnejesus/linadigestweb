# Copiar estos nombres en Hostinger → Environment variables.
# No subir claves reales al ZIP ni al repositorio.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=TU_CLAVE_SECRETA_DE_SERVIDOR

# Claves temporales propias para el primer ingreso. Usa valores nuevos.
LINADIGEST_PASSWORD_BODEGA=CAMBIAR-CLAVE-BODEGA
LINADIGEST_PASSWORD_DESPACHO=CAMBIAR-CLAVE-DESPACHO
LINADIGEST_PASSWORD_MIGUEL=CAMBIAR-CLAVE-MIGUEL
LINADIGEST_PASSWORD_DANIELA=CAMBIAR-CLAVE-DANIELA
